__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.venv/
venv/
# scratch / large intermediate artifacts
scratch/
results/**/raw_checkpoints/
*.pt
.claude/
# Results ARE part of the deliverable -- the README cites them and the claims
# are only checkable against them. Only bulky intermediates are excluded.
figures/
results/**/raw_checkpoints/
results/*.log
!results/hparam_search_stage1.log
# Output of `run_phase1.py --smoke`: a pipeline check, not a result.
results/smoke.jsonl

# Phase 2 raw data: fetched by scripts/download_koplev.py, digest-verified.
# Not vendored -- see docs/phase2_dataset.md.
data/raw/

# Phase 2 pipeline check, regenerated on demand (mirrors results/smoke.jsonl).
results/phase2/smoke.jsonl
results/phase2_residual/smoke.jsonl

# d-chain source: fetched and digest-verified by scripts/prepare_dchain_null.py,
# not vendored (GPL-3.0, and the Mendeley deposit is handled the same way).
third_party/

# Null simulation inputs and raw MCMC output: regenerated by
# scripts/run_dchain_null.py. Tens of MB per seed; the committed evidence is
# results/dchain_null/{metrics.jsonl,summary/,configs/}.
results/dchain_null/simulations/

results/dchain_null/smoke.jsonl
results/dchain_null/*.jsonl.tmp

# Phase 3: raw external API responses. The mapping CSV and the provenance
# digest over this directory are committed; the ~500 raw JSON bodies are not,
# because they are large, regenerable, and their content is already pinned by
# the digest.
data/external/cache/
results/phase3_entity_ood/smoke.jsonl
results/phase3_entity_ood/.sweep.lock

# Phase 4 pipeline check, regenerated on demand. A pipeline check is not a result.
results/phase4_chemlex/smoke.jsonl
results/phase4_chemlex/.sweep.lock
results/phase4_chemlex/*.jsonl.partial
results/phase4_chemlex/*.csv.partial
